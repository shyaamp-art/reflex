# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Use supabase to enable live persistence; any other value keeps offline mode.
REFLEX_PERSISTENCE=dummy
# Server-only service-role key is required for privileged writes. Never use a
# publishable/anon key with REFLEX_PERSISTENCE=supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibility aliases accepted when values come from a Supabase frontend setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Development only: used by npm run seed:demo-auth. Supabase Auth stores only
# password hashes. Never use these demo values in a production project.
DEMO_DEFAULT_PASSWORD="ReflexDemo!2026"
DEMO_MANAGER_PASSWORD=""
DEMO_EMPLOYEE_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
